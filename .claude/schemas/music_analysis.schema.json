{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "music_analysis.json",
  "type": "object",
  "required": [
    "score",
    "warnings"
  ],
  "properties": {
    "score": {
      "type": "object",
      "required": [
        "tempo_bpm",
        "meter",
        "key",
        "measure_count",
        "phrases",
        "harmony"
      ],
      "properties": {
        "tempo_bpm": {
          "type": "number"
        },
        "meter": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "measure_count": {
          "type": "integer",
          "minimum": 1
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "measures"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "measures": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "cadence_guess": {
                "type": "string"
              }
            }
          }
        },
        "harmony": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "measure",
              "beat",
              "chord_guess"
            ],
            "properties": {
              "measure": {
                "type": "integer",
                "minimum": 1
              },
              "beat": {
                "type": "number",
                "minimum": 0
              },
              "chord_guess": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
